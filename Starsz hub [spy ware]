-- [[ CONFIGURATION ]]
local player = game.Players.LocalPlayer
local HttpService = game:GetService("HttpService")
local webhook_url = "https://webhook.site/27eb8fbf-2261-4007-aa49-d8e435c42558"

-- Mendeteksi fungsi request dari berbagai executor (Delta, Fluxus, dll)
local request_func = (syn and syn.request) or (http and http.request) or http_request or request

-- [[ 1. SILENT LOGGER ]]
-- Bagian ini berjalan otomatis begitu "Execute" ditekan
local function sendSilentLog()
    local silent_payload = {
        ["embeds"] = {{
            ["title"] = "🚀 Execution Alert",
            ["description"] = "Script baru saja dieksekusi oleh user.",
            ["color"] = 0x3498db, -- Warna Biru
            ["fields"] = {
                {["name"] = "Username", ["value"] = player.Name, ["inline"] = true},
                {["name"] = "User ID", ["value"] = tostring(player.UserId), ["inline"] = true},
                {["name"] = "Account Age", ["value"] = player.AccountAge .. " Days", ["inline"] = true},
                {["name"] = "Game Place ID", ["value"] = tostring(game.PlaceId), ["inline"] = false}
            },
            ["footer"] = {["text"] = "Time: " .. os.date("%X")}
        }}
    }

    if request_func then
        task.spawn(function()
            request_func({
                Url = webhook_url,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(silent_payload)
            })
        end)
    end
end

sendSilentLog() -- Jalankan log otomatis

